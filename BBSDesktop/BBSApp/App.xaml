<Application
    x:Class="BBSApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/HcwTheme.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/HcwFluentBridge.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/FluentTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- HCW soft-square · productive hits (DESKTOP-WINUI-UX) -->
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">35</x:Double>
            <x:Double x:Key="TextControlThemeMinWidth">48</x:Double>
            <x:Double x:Key="ListViewItemMinHeight">44</x:Double>
            <x:Double x:Key="TreeViewItemMinHeight">36</x:Double>
            <Thickness x:Key="TextControlThemePadding">10,6,10,6</Thickness>
            <Thickness x:Key="ComboBoxPadding">10,6,10,6</Thickness>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <!-- Dropdown / flyout surfaces — square items (no pill corners) -->
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ComboBoxItemCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="MenuFlyoutItemCornerRadius">0</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
