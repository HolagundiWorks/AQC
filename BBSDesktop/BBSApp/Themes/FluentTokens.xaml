<!--
  AQC-Core product tokens — HCW soft neu (Fog / Soft / White · 8px · Radiant Orange).
  Fluent* style keys kept for page compatibility; materials come from HcwFluentBridge.
  Canon: esti docs/esti/DESKTOP-WINUI-UX.md
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing ramp (8pt) -->
    <x:Double x:Key="SpacingNone">0</x:Double>
    <x:Double x:Key="SpacingXXS">2</x:Double>
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">8</x:Double>
    <x:Double x:Key="SpacingL">12</x:Double>
    <x:Double x:Key="SpacingXL">16</x:Double>
    <x:Double x:Key="SpacingXXL">20</x:Double>
    <x:Double x:Key="SpacingXXXL">24</x:Double>
    <x:Double x:Key="PageMargin">24</x:Double>
    <x:Double x:Key="SectionGap">16</x:Double>
    <Thickness x:Key="PagePadding">24,20</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingCompact">12,10</Thickness>

    <!-- Type scale -->
    <!-- Hits: taskbar/ribbon 35 · dock/primary 44 (PORTAL_CHROME peer) -->
    <x:Double x:Key="ControlFontSize">13</x:Double>
    <x:Double x:Key="ControlMinHeight">35</x:Double>
    <x:Double x:Key="HitTaskbar">35</x:Double>
    <x:Double x:Key="HitDock">44</x:Double>
    <x:Double x:Key="BodyFontSize">13</x:Double>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="MetaFontSize">11</x:Double>
    <x:Double x:Key="FormGroupFontSize">12</x:Double>
    <x:Double x:Key="SectionFontSize">15</x:Double>
    <x:Double x:Key="TitleFontSize">22</x:Double>
    <x:Double x:Key="RibbonTabFontSize">13</x:Double>
    <x:Double x:Key="RibbonCommandCaptionSize">12</x:Double>
    <x:Double x:Key="RibbonCommandIconSize">22</x:Double>
    <x:Double x:Key="BrandBarHeight">56</x:Double>

    <!-- Soft-square 8px everywhere -->
    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">8</CornerRadius>

    <Thickness x:Key="CardStrokeThickness">1</Thickness>

    <!-- Layer 1 flat white card -->
    <Style x:Key="FluentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HcwWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HcwEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CardStrokeThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <Style x:Key="FluentCardCompactStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}"/>
    </Style>

    <!-- Soft raised layer (chrome peer) -->
    <Style x:Key="FluentLayerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HcwSoftBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="28"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource HcwMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <Style x:Key="FormSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FormGroupFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HcwMutedBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
        <Setter Property="CharacterSpacing" Value="20"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="BodyStrongStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource HcwMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MetaFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource HcwMutedBrush}"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="14"/>
    </Style>

    <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MetaFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HcwMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="CharacterSpacing" Value="30"/>
    </Style>

    <!-- Ribbon tabs — soft merge into Soft command tray -->
    <Style x:Key="RibbonTabStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{StaticResource HitTaskbar}"/>
        <Setter Property="Height" Value="{StaticResource HitTaskbar}"/>
        <Setter Property="Padding" Value="16,0,16,0"/>
        <Setter Property="FontSize" Value="{StaticResource RibbonTabFontSize}"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HcwMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Background" Value="{StaticResource HcwAccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HcwOnAccentBrush}"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="Padding" Value="12,4,12,5"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="Padding" Value="10,2,10,3"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
    </Style>

    <Style x:Key="PageRootStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PagePadding}"/>
        <Setter Property="RowSpacing" Value="{StaticResource SectionGap}"/>
        <Setter Property="ColumnSpacing" Value="{StaticResource SectionGap}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style TargetType="NumberBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="SpinButtonPlacementMode" Value="Compact"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <!-- Dropdown items — square (no corner radius) -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusNone}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusNone}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusNone}"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="Padding" Value="12,4,12,5"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style TargetType="HyperlinkButton">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style TargetType="NavigationViewItem">
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style TargetType="MenuBar">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
    </Style>

    <TransitionCollection x:Key="PageContentTransitions">
        <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False"/>
    </TransitionCollection>

    <TransitionCollection x:Key="CardContentTransitions">
        <EntranceThemeTransition FromVerticalOffset="6" IsStaggeringEnabled="True"/>
    </TransitionCollection>

    <!-- Construction element icons — light / dark SVG (see Assets/Icons/ATTRIBUTION.md) -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SvgImageSource x:Key="NavIconColumn" UriSource="ms-appx:///Assets/Icons/column.svg"/>
            <SvgImageSource x:Key="NavIconBeam" UriSource="ms-appx:///Assets/Icons/beam.svg"/>
