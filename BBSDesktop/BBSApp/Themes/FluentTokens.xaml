            <SvgImageSource x:Key="NavIconWall" UriSource="ms-appx:///Assets/Icons/wall.svg"/>
            <SvgImageSource x:Key="NavIconStair" UriSource="ms-appx:///Assets/Icons/stair.svg"/>
            <SvgImageSource x:Key="NavIconMasonry" UriSource="ms-appx:///Assets/Icons/masonry.svg"/>
            <SvgImageSource x:Key="NavIconPlaster" UriSource="ms-appx:///Assets/Icons/plaster.svg"/>
            <SvgImageSource x:Key="NavIconPcc" UriSource="ms-appx:///Assets/Icons/pcc.svg"/>
            <SvgImageSource x:Key="NavIconEarthwork" UriSource="ms-appx:///Assets/Icons/earthwork.svg"/>
            <SvgImageSource x:Key="NavIconSsm" UriSource="ms-appx:///Assets/Icons/ssm.svg"/>
            <SvgImageSource x:Key="NavIconShuttering" UriSource="ms-appx:///Assets/Icons/shuttering.svg"/>
            <SvgImageSource x:Key="NavIconFlooring" UriSource="ms-appx:///Assets/Icons/flooring.svg"/>
            <SvgImageSource x:Key="NavIconPainting" UriSource="ms-appx:///Assets/Icons/painting.svg"/>
            <SvgImageSource x:Key="NavIconWaterproofing" UriSource="ms-appx:///Assets/Icons/waterproofing.svg"/>
            <SvgImageSource x:Key="NavIconDpc" UriSource="ms-appx:///Assets/Icons/dpc.svg"/>
            <SvgImageSource x:Key="NavIconCoping" UriSource="ms-appx:///Assets/Icons/coping.svg"/>
            <SvgImageSource x:Key="NavIconScreed" UriSource="ms-appx:///Assets/Icons/screed.svg"/>
            <SvgImageSource x:Key="NavIconVdf" UriSource="ms-appx:///Assets/Icons/vdf.svg"/>
            <SvgImageSource x:Key="NavIconSkirting" UriSource="ms-appx:///Assets/Icons/skirting.svg"/>
            <SvgImageSource x:Key="NavIconParapet" UriSource="ms-appx:///Assets/Icons/parapet.svg"/>
            <SvgImageSource x:Key="NavIconPlinth" UriSource="ms-appx:///Assets/Icons/plinth.svg"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SvgImageSource x:Key="NavIconColumn" UriSource="ms-appx:///Assets/Icons/column.svg"/>
            <SvgImageSource x:Key="NavIconBeam" UriSource="ms-appx:///Assets/Icons/beam.svg"/>
