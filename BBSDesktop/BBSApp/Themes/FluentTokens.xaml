            <SvgImageSource x:Key="NavIconPlaster" UriSource="ms-appx:///Assets/Icons/plaster.svg"/>
            <SvgImageSource x:Key="NavIconPcc" UriSource="ms-appx:///Assets/Icons/pcc.svg"/>
