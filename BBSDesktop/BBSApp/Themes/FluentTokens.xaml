            <SvgImageSource x:Key="NavIconPainting" UriSource="ms-appx:///Assets/Icons/painting.svg"/>
            <SvgImageSource x:Key="NavIconWaterproofing" UriSource="ms-appx:///Assets/Icons/waterproofing.svg"/>
            <SvgImageSource x:Key="NavIconDpc" UriSource="ms-appx:///Assets/Icons/dpc.svg"/>
            <SvgImageSource x:Key="NavIconCoping" UriSource="ms-appx:///Assets/Icons/coping.svg"/>
            <SvgImageSource x:Key="NavIconScreed" UriSource="ms-appx:///Assets/Icons/screed.svg"/>
