<!--
  Bridge Fluent ThemeResource keys → HCW neumorphic light palette.
  Merged after XamlControlsResources + HcwTheme so pages using ThemeResource
  Card*/Layer*/Text*/Accent* pick up Fog / Soft / White / Radiant Orange.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#141517"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C6370"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#5C6370"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64512"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF4F18"/>
            <!-- Kill acrylic “glass” — solid soft fill -->
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F2F4F7"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#141517"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C6370"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#5C6370"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64512"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F2F4F7"/>
        </ResourceDictionary>
        <!-- Dark still maps to HCW light neu — product law is light-first soft neu -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#141517"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C6370"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#5C6370"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#F2F4F7"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D0D4DC"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64512"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF4F18"/>
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F2F4F7"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
